{
  "appId": "com.gapsense.crossingpractice",
  "appName": "CrossingTime",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0F766E"
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#0F766E",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DEFAULT"
    }
  },
  "zoomEnabled": true
}
