# ---------------------------------------------------------------
# iOS / Capacitor
# ---------------------------------------------------------------
# CocoaPods dependencies are restored with `pod install`; Podfile.lock IS
# committed so everyone resolves identical versions.
ios-app/ios/App/Pods/

# Capacitor copies www/ into the native project on every `cap copy`. It is a
# build artifact — editing it does nothing, since the next copy overwrites it.
ios-app/ios/App/App/public/

# Xcode build output and per-user state
ios-app/ios/App/build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
*.ipa
*.dSYM.zip
*.dSYM
